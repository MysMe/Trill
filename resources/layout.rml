<rml>

	<head>
		<title>Demo</title>
		<link type="text/rcss" href="rml.rcss" />
		<style>
			body {
				margin: auto;
			}

			div#title_bar div#icon {
				display: none;
			}

			div#content {
				text-align: left;
			}

			div.card {
				flex-grow: 1;
				width: 200px; /* Set a fixed width */
				height: 150px; /* Set a fixed height */
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>

	<body data-model="model">

		<div style="display: flex; justify-content: space-between; width: 100%; flex-wrap:wrap;">
			<card style="background-color: #b10000;">
				<cardtitle>
					Hotfixes
				</cardtitle>
				<cardcontent>
					{{hotfixes.count}}
				</cardcontent>
				<cardunseentext data-if="hotfixes.unseen != 0" style="background-color: #640000;">
					Unseen: {{hotfixes.unseen}}
				</cardunseentext>
				<cardsubtext data-if="hotfixes.count != 0 && hotfixes.unseen == 0">
					Most Recent<br/>{{hotfixes.last}}
				</cardsubtext>
			</card>

			<card style="background-color: #FF8C00;">
				<cardtitle>
					Medium
				</cardtitle>
				<cardcontent>
					{{medium.count}}
				</cardcontent>
				<cardunseentext data-if="medium.count != 0 && medium.unseen != 0" style="background-color: #b26200;">
					Unseen: {{medium.unseen}}
				</cardunseentext>
				<cardsubtext data-if="medium.count != 0 && medium.unseen == 0">
					Most Recent<br/>{{medium.last}}
				</cardsubtext>
			</card>

			<card style="background-color: #2626b0;">
				<cardtitle>
					Low
				</cardtitle>
				<cardcontent>
					{{low.count}}
				</cardcontent>
				<cardunseentext data-if="low.count != 0 && low.unseen != 0" style="background-color: #151563;">
					Unseen: {{low.unseen}}
				</cardunseentext>
				<cardsubtext data-if="low.count != 0 && low.unseen == 0">
					Most Recent<br/>{{low.last}}
				</cardsubtext>
			</card>
			
			<card style="background-color: #00b2b2;">
				<cardtitle>
					Very Low
				</cardtitle>
				<cardcontent>
					{{veryLow.count}}
				</cardcontent>
				<cardunseentext data-if="veryLow.count != 0 && veryLow.unseen != 0" style="background-color: #006565;">
					Unseen: {{veryLow.unseen}}
				</cardunseentext>
				<cardsubtext data-if="veryLow.count != 0 && veryLow.unseen == 0">
					Most Recent<br/>{{veryLow.last}}
				</cardsubtext>
			</card>

			<card style="background-color: #00a600;">
				<cardtitle>
					Resolved
				</cardtitle>
				<cardcontent>
					{{resolved}}
				</cardcontent>
				<cardsubtext>
					Last Synced<br/>{{syncLast}}
				</cardsubtext>
			</card>
		</div>
	</body>
</rml>