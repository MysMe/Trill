<rml>

	<head>
		<title>Demo</title>
		<link type="text/rcss" href="rml.rcss" />
		<style>
			body {
				margin: auto;
			}

			div#title_bar div#icon {
				display: none;
			}

			div#content {
				text-align: left;
			}

			div.card {
				flex-grow: 1;
				width: 200px; /* Set a fixed width */
				height: 150px; /* Set a fixed height */
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>

	<body data-model="model">
		{{Bugs_And_Queries() | where('Priority==Hotfix', 	'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | as('Hotfixes')}}
		{{Bugs_And_Queries() | where('Priority==Regular', 	'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | as('Regulars')}}
		{{Bugs_And_Queries() | where('Priority==Low', 		'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | as('Lows')}}
		{{Bugs_And_Queries() | where('Priority==Very Low', 	'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | as('Very Lows')}}

		<div style="display: flex; justify-content: space-between; width: 100%; flex-wrap:wrap;">
			<card style="background-color: #b10000;">
				<cardtitle>
					Hotfixes
				</cardtitle>
				<cardcontent>
					{{from('Hotfixes') | count}}
				</cardcontent>
				<cardunseentext data-if="from('Hotfixes') | where('Opsyte Status==Not Seen') | count" style="background-color: #640000;">
					Unseen: {{from('Hotfixes') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(from('Hotfixes') | count) != 0 && (from('Hotfixes') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{from('Hotfixes') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #FF8C00;">
				<cardtitle>
					Regular
				</cardtitle>
				<cardcontent>
					{{from('Regulars') | count}}
				</cardcontent>
				<cardunseentext data-if="from('Regulars') | where('Opsyte Status==Not Seen') | count" style="background-color: #b26200;">
					Unseen: {{from('Regulars') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(from('Regulars') | count) != 0 && (from('Regulars') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{from('Regulars') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #2626b0;">
				<cardtitle>
					Low
				</cardtitle>
				<cardcontent>
					{{from('Lows') | count}}
				</cardcontent>
				<cardunseentext data-if="from('Lows') | where('Opsyte Status==Not Seen') | count" style="background-color: #151563;">
					Unseen: {{from('Lows') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(from('Lows') | count) != 0 && (from('Lows') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{from('Lows') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #00b2b2;">
				<cardtitle>
					Very Low
				</cardtitle>
				<cardcontent>
					{{from('Very Lows') | count}}
				</cardcontent>
				<cardunseentext data-if="from('Very Lows') | where('Opsyte Status==Not Seen') | count" style="background-color: #006565;">
					Unseen: {{from('Very Lows') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(from('Very Lows') | count) != 0 && (from('Very Lows') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{from('Very Lows') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #00a600;">
				<cardtitle>
					Resolved
				</cardtitle>
				<cardcontent>
					{{Resolved() | today('Resolved At') | count}}
				</cardcontent>
				<cardsubtext>
					Last Synced<br/>{{syncLast}}
				</cardsubtext>
			</card>

			<card style="background-color: #800080;">
				<cardtitle>
					On Troncbox Today
				</cardtitle>
				<cardcontent style="margin-top: 1rem;">
					{{Todays_Troncbox_Legend() | members('initials')}}
				</cardcontent>
			</card>
		</div>
	</body>
</rml>