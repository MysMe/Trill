<rml>

	<head>
		<title>Demo</title>
		<link type="text/rcss" href="rml.rcss" />
		<style>
			body {
				margin: auto;
			}

			div#title_bar div#icon {
				display: none;
			}

			div#content {
				text-align: left;
			}

			div.card {
				flex-grow: 1;
				width: 200px; /* Set a fixed width */
				height: 150px; /* Set a fixed height */
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>

	<body data-model="model">
		{{Bugs_And_Queries | where('Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | as('Relevant')}}
		{{load | from('Relevant') | where('Priority==Hotfix') | as('Hotfixes')}}
		{{load | from('Relevant') | where('Priority==Regular') | as('Regulars')}}
		{{load | from('Relevant') | where('Priority==Low') | as('Lows')}}
		{{load | from('Relevant') | where('Priority==Very Low') | as('Very Lows')}}

		<div style="display: flex; justify-content: space-between; width: 100vw; flex-wrap:wrap;">
			<card style="background-color: #b10000;">
				<cardtitle>
					Hotfixes
				</cardtitle>
				<cardcontent>
					{{load | from('Hotfixes') | count}}
				</cardcontent>
				<cardunseentext data-if="load | from('Hotfixes') | where('Opsyte Status==Not Seen') | count" style="background-color: #640000;">
					Unseen: {{load | from('Hotfixes') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(load | from('Hotfixes') | count) != 0 && (load | from('Hotfixes') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{load | from('Hotfixes') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #FF8C00;">
				<cardtitle>
					Regular
				</cardtitle>
				<cardcontent>
					{{load | from('Regulars') | count}}
				</cardcontent>
				<cardunseentext data-if="load | from('Regulars') | where('Opsyte Status==Not Seen') | count" style="background-color: #b26200;">
					Unseen: {{load | from('Regulars') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(load | from('Regulars') | count) != 0 && (load | from('Regulars') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{load | from('Regulars') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #2626b0;">
				<cardtitle>
					Low
				</cardtitle>
				<cardcontent>
					{{load | from('Lows') | count}}
				</cardcontent>
				<cardunseentext data-if="load | from('Lows') | where('Opsyte Status==Not Seen') | count" style="background-color: #151563;">
					Unseen: {{load | from('Lows') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(load | from('Lows') | count) != 0 && (load | from('Lows') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{load | from('Lows') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #00b2b2;">
				<cardtitle>
					Very Low
				</cardtitle>
				<cardcontent>
					{{load | from('Very Lows') | count}}
				</cardcontent>
				<cardunseentext data-if="load | from('Very Lows') | where('Opsyte Status==Not Seen') | count" style="background-color: #006565;">
					Unseen: {{load | from('Very Lows') | where('Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(load | from('Very Lows') | count) != 0 && (load | from('Very Lows') | where('Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{load | from('Very Lows') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #00a600;">
				<cardtitle>
					Resolved
				</cardtitle>
				<cardcontent>
					{{Resolved | today('Resolved At') | count}}
				</cardcontent>
				<cardsubtext>
					Last Synced<br/>{{syncLast}}
				</cardsubtext>
			</card>

			<card style="background-color: #800080;">
				<cardtitle>
					On Troncbox Today
				</cardtitle>
				<div style="width: 100%; height: 75%; display: flex; align-items: center; justify-content: center;">
					<div data-if="(Todays_Troncbox_Legend | members) != ''"
						style="width: 4rem; height: 4rem; overflow: hidden; border-radius: 50px;">
						<img id="legend" style="width: 100%; height: 100%;" />
						{{Todays_Troncbox_Legend | singleProfilePicture('legend')}}
					</div>
				</div>
			</card>
		</div>
	</body>
</rml>