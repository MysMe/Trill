<rml>

	<head>
		<title>Demo</title>
		<link type="text/rcss" href="rml.rcss" />
		<style>
			body {
				margin: auto;
			}

			div#title_bar div#icon {
				display: none;
			}

			div#content {
				text-align: left;
			}

			div.card {
				flex-grow: 1;
				width: 200px; /* Set a fixed width */
				height: 150px; /* Set a fixed height */
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>

	<body data-model="model">

		<div style="display: flex; justify-content: space-between; width: 100%; flex-wrap:wrap;">
			<card style="background-color: #b10000;">
				<cardtitle>
					Hotfixes
				</cardtitle>
				<cardcontent>
					{{hotfixes}}
				</cardcontent>
				<cardunseentext data-if="hotfixes != 0 && hotfixesUnseen != 0" style="background-color: #640000;">
					Unseen: {{hotfixesUnseen}}
				</cardunseentext>
				<cardsubtext data-if="hotfixes != 0 && hotfixesUnseen == 0">
					Most Recent<br/>{{hotfixesLast}}
				</cardsubtext>
			</card>
			<card style="background-color: #FF8C00;">
				<cardtitle>
					Medium
				</cardtitle>
				<cardcontent>
					{{medium}}
				</cardcontent>
				<cardunseentext data-if="medium != 0 && mediumUnseen != 0" style="background-color: #b26200;">
					Unseen: {{mediumUnseen}}
				</cardunseentext>
				<cardsubtext data-if="medium != 0 && mediumUnseen == 0">
					Most Recent<br/>{{mediumLast}}
				</cardsubtext>
			</card>
			<card style="background-color: #2626b0;">
				<cardtitle>
					Low
				</cardtitle>
				<cardcontent>
					{{low}}
				</cardcontent>
				<cardunseentext data-if="low != 0 && lowUnseen != 0" style="background-color: #151563;">
					Unseen: {{lowUnseen}}
				</cardunseentext>
				<cardsubtext data-if="low != 0 && lowUnseen == 0">
					Most Recent<br/>{{lowLast}}
				</cardsubtext>
			</card>
			<card style="background-color: #00b2b2;">
				<cardtitle>
					Very Low
				</cardtitle>
				<cardcontent>
					{{veryLow}}
				</cardcontent>
				<cardunseentext data-if="veryLow != 0 && veryLowUnseen != 0" style="background-color: #006565;">
					Unseen: {{veryLowUnseen}}
				</cardunseentext>
				<cardsubtext data-if="veryLow != 0 && veryLowUnseen == 0">
					Most Recent<br/>{{veryLowLast}}
				</cardsubtext>
			</card>
			<card style="background-color: #00a600;">
				<cardtitle>
					Resolved
				</cardtitle>
				<cardcontent>
					{{resolved}}
				</cardcontent>
				<cardsubtext>
					Last Synced<br/>{{syncLast}}
				</cardsubtext>
			</card>
		</div>

	</body>
</rml>