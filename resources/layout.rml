<rml>

	<head>
		<title>Demo</title>
		<link type="text/rcss" href="rml.rcss" />
		<style>
			body {
				margin: auto;
			}

			div#title_bar div#icon {
				display: none;
			}

			div#content {
				text-align: left;
			}

			div.card {
				flex-grow: 1;
				width: 200px; /* Set a fixed width */
				height: 150px; /* Set a fixed height */
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
		</style>
	</head>

	<body data-model="model">

		<div style="display: flex; justify-content: space-between; width: 100%; flex-wrap:wrap;">
			<card style="background-color: #b10000;">
				<cardtitle>
					Hotfixes
				</cardtitle>
				<cardcontent>
					{{Bugs_And_Queries() | where('Priority==Hotfix', 'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | count}}
				</cardcontent>
				<cardunseentext data-if="Bugs_And_Queries() | where('Priority==Hotfix', 'Opsyte Status==Not Seen') | count" style="background-color: #640000;">
					Unseen: {{Bugs_And_Queries() | where('Priority==Hotfix', 'Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(Bugs_And_Queries() | where('Priority==Hotfix') | count) != 0 && (Bugs_And_Queries() | where('Priority==Hotfix', 'Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{Bugs_And_Queries() | where('Priority==Hotfix') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #FF8C00;">
				<cardtitle>
					Medium
				</cardtitle>
				<cardcontent>
					{{Bugs_And_Queries() | where('Priority==Regular', 'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | count}}
				</cardcontent>
				<cardunseentext data-if="Bugs_And_Queries() | where('Priority==Regular', 'Opsyte Status==Not Seen') | count" style="background-color: #b26200;">
					Unseen: {{Bugs_And_Queries() | where('Priority==Regular', 'Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(Bugs_And_Queries() | where('Priority==Regular') | count) != 0 && (Bugs_And_Queries() | where('Priority==Regular', 'Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{Bugs_And_Queries() | where('Priority==Regular') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #2626b0;">
				<cardtitle>
					Low
				</cardtitle>
				<cardcontent>
					{{Bugs_And_Queries() | where('Priority==Low', 'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | count}}
				</cardcontent>
				<cardunseentext data-if="Bugs_And_Queries() | where('Priority==Low', 'Opsyte Status==Not Seen') | count" style="background-color: #151563;">
					Unseen: {{Bugs_And_Queries() | where('Priority==Low', 'Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(Bugs_And_Queries() | where('Priority==Low') | count) != 0 && (Bugs_And_Queries() | where('Priority==Low', 'Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{Bugs_And_Queries() | where('Priority==Low') | mostRecent}}
				</cardsubtext>
			</card>

			<card style="background-color: #00b2b2;">
				<cardtitle>
					Very Low
				</cardtitle>
				<cardcontent>
					{{Bugs_And_Queries() | where('Priority==Very Low', 'Opsyte Status!=Blocked', 'Opsyte Status!=Needs Additional Info', 'Opsyte Status!=Awaiting Response', 'Opsyte Status!=Deferred') | count}}
				</cardcontent>
				<cardunseentext data-if="Bugs_And_Queries() | where('Priority==Very Low', 'Opsyte Status==Not Seen') | count" style="background-color: #006565;">
					Unseen: {{Bugs_And_Queries() | where('Priority==Very Low', 'Opsyte Status==Not Seen') | count}}
				</cardunseentext>
				<cardsubtext data-if="(Bugs_And_Queries() | where('Priority==Very Low') | count) != 0 && (Bugs_And_Queries() | where('Priority==Very Low', 'Opsyte Status==Not Seen') | count) == 0">
					Most Recent<br/>{{Bugs_And_Queries() | where('Priority==Very Low') | mostRecent}}
				</cardsubtext>
			</card>
			
			<card style="background-color: #00a600;">
				<cardtitle>
					Resolved
				</cardtitle>
				<cardcontent>
					{{Resolved() | today('Resolved At') | count}}
				</cardcontent>
				<cardsubtext>
					Last Synced<br/>{{syncLast}}
				</cardsubtext>
			</card>
		</div>
	</body>
</rml>